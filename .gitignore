# ---------------------------------------------------------------------------
# 本题专属：字体二进制一律不入仓（绝不分发商用字体，也不把 OFL 二进制塞进仓库）
# 字体以 URL + 字节数 + sha256 记录在 data/fonts.lock，由 tools/fetch_fonts.py 获取
# ---------------------------------------------------------------------------
*.ttf
*.otf
*.ttc
*.otc
*.woff
*.woff2
*.dfont
*.pfb
*.pfa
*.ttx

# fixture 生成物与运行产物（脚本与 golden 入仓，产物不入仓）
fixtures/out/
data/fixtures/**/out/
data/fonts/
data/**/*.subset.*
out/
report-out/
*.report.json.tmp
tmp-*/

